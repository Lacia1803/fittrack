# Copy this file to .env.local and fill values. DO NOT commit .env.local to git.

# Public (client) keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (keep private, set them on VPS or CI secrets)
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Optional runtime config
NEXT_PUBLIC_APP_NAME=FitTrack
PORT=3000
NODE_ENV=development
